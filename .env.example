# Non-secret settings. Copy to .env and load it in the cron environment.
# Secrets belong in separate files with mode 600 (see README), never here.

BASE=/opt/heating
VCONTROLD_HOST=127.0.0.1:3002
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=home
INFLUX_BUCKET=heizung
HA_URL=http://homeassistant.local:8123
HA_NOTIFY_SERVICE=notify/mobile_app_my_phone
MQTT_USER=hb

# Room temperature entities in Home Assistant
ENTITY_RAUM_BAD=sensor.bathroom_temperature
ENTITY_RAUM_KUECHE=sensor.kitchen_temperature
ENTITY_RAUM_WC=sensor.wc_temperature
ENTITY_RAUM_SCHLAFEN=sensor.bedroom_temperature
